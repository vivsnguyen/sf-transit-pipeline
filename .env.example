# Copy to .env and fill in. .env is gitignored.
API_511_KEY=your-511-token-here
DATABASE_URL=postgres://transit:transit@localhost:5432/transit
TEST_DATABASE_URL=postgres://transit:transit@localhost:5432/transit_test
REDIS_URL=redis://localhost:6379

# 511 operator id. SF = Muni, BA = BART.
OPERATOR_ID=SF
# How many superseded feed versions to keep around for comparison.
KEEP_FEED_VERSIONS=3
# Cron for the daily static schedule check (America/Los_Angeles).
STATIC_INGEST_CRON=0 4 * * *
LOG_LEVEL=info
